# ============================================================================
# WealthPulse AI: Environment Configuration (.env)
# ============================================================================

# 1. Google Gemini API Key (Required for AI Agents & Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. DhanHQ API Credentials (Recommended for 100% Free Headless Algo-Trading)
# Get your free tokens at: https://dhanhq.co/
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_ACCESS_TOKEN=your_permanent_dhan_access_token_here

# 3. Zerodha Kite Connect API Credentials (Optional)
# Get your keys at: https://developers.kite.trade/
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_ACCESS_TOKEN=your_daily_kite_access_token_here

# 4. Razorpay API Credentials (Optional)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 5. Application State Store
STATE_FILE_PATH=./memory/state_db.json
