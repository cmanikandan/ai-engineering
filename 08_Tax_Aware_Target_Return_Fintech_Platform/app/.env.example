# ============================================================================
# WealthPulse AI: Environment Configuration (.env)
# ============================================================================

# 1. Google Gemini API Key (Required for AI Agents & Reasoning)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Razorpay API Credentials (Optional - Falls back to Sandbox Simulator if omitted)
# Get your test/live keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 3. Zerodha Kite Connect API Credentials (Optional - Falls back to Sandbox Simulator if omitted)
# Get your keys at: https://developers.kite.trade/
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_ACCESS_TOKEN=your_daily_kite_access_token_here

# 4. Application State Store
STATE_FILE_PATH=./memory/state_db.json
